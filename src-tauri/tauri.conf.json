{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora",
  "version": "0.32.0",
  "identifier": "de.nexora.notizen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexora",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "Schnellerfassung",
        "width": 640,
        "height": 128,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      },
      {
        "label": "picker",
        "title": "Snippet einfügen",
        "width": 640,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/bilder/**", "$APPCONFIG/vorschau/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "Nexora",
    "shortDescription": "Notizen, LOP und Runbooks",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      },
      "wix": {
        "language": "de-DE",
        "upgradeCode": "8B87B2D9-705D-5833-921B-E0CCF8B75664"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGOEMzMkI4NEQzOTU1MkUKUldRdVZUbE51REtNei8xWWJFQ1hwbzhVU0Z1ZEQwaEdCaFNkaGkyS3ZxQTV0NmR2YWZLT3RMOWcK",
      "endpoints": ["https://github.com/yourShika/Nexora/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
